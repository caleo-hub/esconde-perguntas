rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function moderator() {
      return verified()
        && exists(/databases/$(database)/documents/marketplaceModerators/$(request.auth.uid))
        && get(/databases/$(database)/documents/marketplaceModerators/$(request.auth.uid)).data.ativo == true;
    }

    function notBlocked() {
      return !signedIn()
        || !exists(/databases/$(database)/documents/marketplaceBlocks/$(request.auth.uid))
        || get(/databases/$(database)/documents/marketplaceBlocks/$(request.auth.uid)).data.ativo != true;
    }

    function validSlot(slot) {
      return slot in [1, 2, 3];
    }

    function slotDocumentId(uid, slot) {
      return slot == 1 ? uid + '_1' : slot == 2 ? uid + '_2' : uid + '_3';
    }

    function validSubmission(data, ownerUid, slot) {
      return data.keys().hasAll([
          'ownerUid', 'slot', 'sourceListId', 'targetPublicationId',
          'titulo', 'descricao', 'autorApelido', 'perguntas',
          'quantidade', 'status', 'submittedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'slot', 'sourceListId', 'targetPublicationId',
          'titulo', 'descricao', 'autorApelido', 'perguntas',
          'quantidade', 'status', 'submittedAt', 'cancelledAt',
          'decisionAt', 'decisionBy', 'publicationId', 'rejectionReason'
        ])
        && data.ownerUid == ownerUid
        && data.slot == slot
        && validSlot(slot)
        && data.sourceListId is string
        && (data.targetPublicationId == null || data.targetPublicationId is string)
        && data.titulo is string && data.titulo.size() >= 1 && data.titulo.size() <= 60
        && data.descricao is string && data.descricao.size() <= 280
        && data.autorApelido is string && data.autorApelido.size() >= 1 && data.autorApelido.size() <= 40
        && data.perguntas is list && data.perguntas.size() >= 1 && data.perguntas.size() <= 200
        && data.quantidade == data.perguntas.size()
        && data.status == 'pending'
        && data.submittedAt == request.time;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /marketplaceModerators/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || moderator());
      allow list: if moderator();
      allow create, update, delete: if false;
    }

    match /marketplaceBlocks/{userId} {
      allow get: if moderator();
      allow list: if moderator();
      allow create, update: if moderator()
        && userId != request.auth.uid
        && request.resource.data.keys().hasOnly(['ativo', 'motivo', 'updatedAt'])
        && request.resource.data.ativo == true
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() <= 300
        && request.resource.data.updatedAt == request.time;
      allow delete: if moderator() && userId != request.auth.uid;
    }

    match /marketplaceSubmissions/{submissionId} {
      // Clients check their three fixed slots before submitting; allow those reads even when a slot is empty.
      allow get: if moderator() || (signedIn() && (
        submissionId == request.auth.uid + '_1'
        || submissionId == request.auth.uid + '_2'
        || submissionId == request.auth.uid + '_3'
      ));
      allow list: if moderator() && request.query.limit <= 25;
      allow create: if verified()
        && notBlocked()
        && submissionId == slotDocumentId(request.auth.uid, request.resource.data.slot)
        && validSubmission(request.resource.data, request.auth.uid, request.resource.data.slot);
      allow update: if moderator()
        || (
          verified()
          && resource.data.ownerUid == request.auth.uid
          && submissionId == slotDocumentId(request.auth.uid, resource.data.slot)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && request.resource.data.cancelledAt == request.time
        )
        || (
          verified()
          && notBlocked()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status != 'pending'
          && request.time >= resource.data.submittedAt + duration.value(24, 'h')
          && submissionId == slotDocumentId(request.auth.uid, resource.data.slot)
          && validSubmission(request.resource.data, request.auth.uid, resource.data.slot)
        );
      allow delete: if false;
    }

    match /marketplaceLists/{publicationId} {
      allow get: if resource.data.status == 'active'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || moderator();
      allow list: if request.query.limit <= 50
        && (resource.data.status == 'active'
          || (signedIn() && resource.data.ownerUid == request.auth.uid)
          || moderator());
      allow create: if moderator()
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.acesso == 'free';
      allow update: if moderator()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'active'
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.withdrawnAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt'])
        );
      allow delete: if moderator();

      match /content/{contentId} {
        allow get: if get(/databases/$(database)/documents/marketplaceLists/$(publicationId)).data.status == 'active'
          || (signedIn() && get(/databases/$(database)/documents/marketplaceLists/$(publicationId)).data.ownerUid == request.auth.uid)
          || moderator();
        allow list: if moderator();
        allow create, update: if moderator()
          && getAfter(/databases/$(database)/documents/marketplaceLists/$(publicationId)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/marketplaceLists/$(publicationId)).data.ownerUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['versao', 'perguntas'])
          && request.resource.data.versao is int
          && request.resource.data.perguntas is list
          && request.resource.data.perguntas.size() >= 1
          && request.resource.data.perguntas.size() <= 200;
        allow delete: if moderator();
      }
    }

    match /marketplaceReports/{reportId} {
      allow get: if moderator() || (verified() && resource.data.reporterUid == request.auth.uid);
      allow list: if moderator() && request.query.limit <= 25;
      allow create: if verified()
        && notBlocked()
        && reportId == request.resource.data.publicationId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'publicationId', 'reporterUid', 'reason', 'note', 'status', 'createdAt'
        ])
        && request.resource.data.publicationId is string
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['inaccurate', 'copyright', 'inappropriate', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/marketplaceLists/$(request.resource.data.publicationId)).data.status == 'active';
      allow update: if moderator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.resolution is string
        && request.resource.data.resolution.size() <= 300
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
